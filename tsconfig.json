{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ES2020",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,

		"typeRoots": ["./src/types", "./node_modules/@types"],
		"types": ["node", "express", "express-fileupload"]
	},
	"include": ["src"]
}
